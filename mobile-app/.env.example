# Mobile app environment variables (template - safe to commit)
# Copy to `.env` and fill in real values. `.env` is gitignored.

# --- DigitalOcean AI Agent (SECRET) ---
DO_AGENT_ENDPOINT=https://your-agent.agents.do-ai.run
DO_AGENT_KEY=your-do-agent-key
DO_AGENT_MODEL=

# --- Google OAuth (public client identifiers) ---
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# --- Auth0 (public client identifiers) ---
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your-auth0-client-id
EXPO_PUBLIC_AUTH0_AUDIENCE=https://your-api-identifier
EXPO_PUBLIC_AUTH0_DB_CONNECTION=Username-Password-Authentication

# --- API base ---
EXPO_PUBLIC_API_BASE_URL=https://your-server.example.com/api
